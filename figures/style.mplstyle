# Shared figure style (light). Dark variants add style-dark.mplstyle on top.
figure.facecolor: fcfcfb
axes.facecolor: fcfcfb
savefig.facecolor: fcfcfb
figure.dpi: 100
savefig.dpi: 200

font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 11
text.color: 0b0b0b
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 10
axes.titlecolor: 0b0b0b
axes.labelsize: 11
axes.labelcolor: 52514e
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: False
grid.color: e1e0d9
grid.linewidth: 0.8
grid.linestyle: -
xtick.color: c3c2b7
ytick.color: c3c2b7
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.labelsize: 10
ytick.labelsize: 10
legend.frameon: False
legend.fontsize: 10
legend.labelcolor: 52514e
lines.linewidth: 2
lines.solid_capstyle: round
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])
